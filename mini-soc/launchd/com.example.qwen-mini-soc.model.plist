<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.qwen-mini-soc.model</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/mini-soc/.venv/bin/mlx_lm.server</string>
    <string>--model</string>
    <string>lmstudio-community/Qwen3.8-27B-MLX-8bit</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8090</string>
    <!-- an uncapped prompt cache ran Metal out of memory in the lab (2026-09-24) -->
    <string>--prompt-cache-bytes</string>
    <string>8000000000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/mini-soc/state/model.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/mini-soc/state/model.log</string>
</dict>
</plist>
